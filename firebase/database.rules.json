{
  "rules": {
    ".read": false,
    ".write": false,
    "trips": {
      "$trip": {
        ".read": "auth != null && $trip.length >= 16 && (data.child('access').child(auth.uid).exists() || !data.child('access').exists() || auth.uid === 'vgBqQDXueQVvpmaLqRYGnvPx1043')",
        ".write": "auth != null && $trip.length >= 16 && newData.exists() && ((data.child('access').child(auth.uid).exists() && newData.child('access').exists()) || !data.child('access').exists())",
        "city": {
          ".read": "auth != null"
        },
        "keys": {
          "$key": {
            ".read": "auth != null"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('trips').child($trip).child('city').exists() && !data.child('approvals').exists() && !newData.child('approvals').exists()",
            ".validate": "!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 100)"
          }
        },
        "claims": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        },
        "access": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.isString() && root.child('trips').child($trip).child('keys').child(newData.parent().parent().child('claims').child($uid).val()).val() === newData.val()"
          }
        }
      }
    },
    "blobs": {
      "$trip": {
        "$blob": {
          ".read": "auth != null && $trip.length >= 16 && (root.child('trips').child($trip).child('access').child(auth.uid).exists() || !root.child('trips').child($trip).child('access').exists())",
          ".write": "auth != null && $trip.length >= 16 && (root.child('trips').child($trip).child('access').child(auth.uid).exists() || !root.child('trips').child($trip).child('access').exists())",
          ".validate": "newData.isString() && newData.val().length <= 3000000"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.length == 10 && (!data.exists() || root.child('trips').child(data.val()).child('access').child(auth.uid).exists() || !root.child('trips').child(data.val()).child('access').exists()) && (!newData.exists() || root.child('trips').child(newData.val()).child('access').child(auth.uid).exists() || !root.child('trips').child(newData.val()).child('access').exists())",
        ".validate": "newData.isString() && newData.val().length >= 16"
      }
    },
    "push": {
      ".read": "auth != null && auth.uid === 'vgBqQDXueQVvpmaLqRYGnvPx1043'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'vgBqQDXueQVvpmaLqRYGnvPx1043')"
      }
    }
  }
}
